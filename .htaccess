# Настройки сервера. Файл заливается на хостинг вместе с сайтом.

RewriteEngine On

# --- Весь трафик на HTTPS ---
# Сертификат Let's Encrypt выпущен 30.07.2026, продлевается автоматически.
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- Один адрес вместо двух ---
# Без этого trexgo.ru и www.trexgo.ru — разные сайты для поисковиков.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# --- Кодировка ---
AddDefaultCharset UTF-8

# Старые браузеры и поисковики просят /favicon.ico — отдаём им SVG.
RewriteRule ^favicon\.ico$ /favicon.svg [L]

# --- Кэш для картинок и стилей ---
# Браузер не перекачивает то, что не менялось.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Сжатие ---
# Главная в сжатом виде — 12 КБ вместо 48 КБ.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Мелочи безопасности ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Не показывать содержимое папок, если в них нет index.html
Options -Indexes

# Служебные файлы наружу не отдаём. Правило через mod_rewrite —
# работает и на Apache 2.2, и на 2.4, в отличие от Require/Deny.
RewriteRule ^\.ftp-deploy-sync-state\.json$ - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
